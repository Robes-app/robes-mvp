{
  "name": "@robes/mobile",
  "main": "expo-router/entry",
  "dependencies": {
    "@better-auth/expo": "1.7.7",
    "@expo-google-fonts/cormorant": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/ui": "~58.0.22",
    "@robes/analytics": "workspace:*",
    "@robes/api-client": "workspace:*",
    "@robes/contracts": "workspace:*",
    "@robes/copy": "workspace:*",
    "@robes/core": "workspace:*",
    "@robes/icons": "workspace:*",
    "@robes/logger": "workspace:*",
    "@robes/tokens": "workspace:*",
    "@robes/ui-native": "workspace:*",
    "@tanstack/react-query": "5.103.2",
    "better-auth": "1.7.7",
    "expo": "~58.0.17",
    "expo-application": "~58.1.2",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "posthog-react-native": "4.76.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "4.3.3",
    "uniwind": "1.12.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "expo-doctor": "1.20.4",
    "jest": "~29.7.0",
    "jest-expo": "~58.0.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "expo:doctor": "expo-doctor",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "e2e": "./e2e/run.sh"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 60000,
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|native-base|standard-navigation|uniwind))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^react$": "<rootDir>/node_modules/react",
      "^react/(.*)$": "<rootDir>/node_modules/react/$1",
      "^react-native-svg$": "<rootDir>/node_modules/react-native-svg",
      "^@tanstack/react-query$": "<rootDir>/node_modules/@tanstack/react-query"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/support/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ]
  }
}
