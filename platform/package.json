{
  "name": "robes-platform",
  "private": true,
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "bootstrap": "pnpm install && pnpm --filter @robes/tokens build && node scripts/init-env.mjs",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@robes/app",
    "dev:mobile": "pnpm --filter @robes/mobile start",
    "dev:ios": "pnpm --filter @robes/mobile ios",
    "dev:android": "pnpm --filter @robes/mobile android",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/db/src/database.types.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm db:test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.13.6",
    "supabase": "2.117.0",
    "turbo": "2.11.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
