  "peerDependencies": {
    "expo-haptics": ">=58",
    "expo-image": ">=58",
    "react": "^19.2",
    "react-native": ">=0.88",
    "react-native-safe-area-context": ">=5",
    "react-native-svg": ">=15",
    "uniwind": "^1.12"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.3.0",
    "expo": "58.0.17",
    "expo-haptics": "58.0.7",
    "expo-image": "58.0.16",
    "jest": "29.7.0",
    "jest-expo": "58.0.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
