{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_APP_ENV": "dev"
      }
    },
    "staging": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_API_URL": "https://staging.byrobes.com"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://app.byrobes.com"
      }
    }
  },
  "submit": {
    "staging": {
      "ios": {
        "ascAppId": "REPLACE_WITH_ROBES_STAGING_ASC_APP_ID"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "REPLACE_WITH_ROBES_ASC_APP_ID"
      }
    }
  }
}
