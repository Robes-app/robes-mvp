# The web app that serves /api (pnpm dev:web). iOS simulator: localhost works.
# Physical device or Android emulator: use your machine's LAN IP, e.g. http://192.168.1.20:3300
EXPO_PUBLIC_API_URL=http://localhost:3300

# Optional (publishable, not secrets). Unset → analytics and error reporting stay off.
# EXPO_PUBLIC_POSTHOG_KEY=phc_...
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# EXPO_PUBLIC_APP_ENV=dev
