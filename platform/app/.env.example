NODE_ENV=development
APP_ENV=dev
# Local docker services (pnpm services:up).
DATABASE_URL=postgres://robes_app:robes_app_local@127.0.0.1:55432/robes
SMTP_URL=smtp://127.0.0.1:51025
MAIL_FROM=Robes <hello@byrobes.local>
# Worker CLIs (pnpm notify): links in mail point here.
APP_URL=http://localhost:3300
UNSUB_HMAC_KEY=local-dev-unsub-key-change-me-0123456789abcdef
# Replies to the sequence mails reach a person (the 7-day brief: annie@byrobes.com).
# NOTIFY_REPLY_TO=annie@byrobes.com
# Media: local MinIO (pnpm media:setup creates the bucket). Deployed envs use CloudFront instead.
MEDIA_BUCKET=robes-dev-media
# localhost (not 127.0.0.1): browsers exempt it from CSP upgrade-insecure-requests under next start.
MEDIA_S3_ENDPOINT=http://localhost:59000
MEDIA_S3_ACCESS_KEY_ID=robes
MEDIA_S3_SECRET_ACCESS_KEY=robes-local-secret
# Better Auth. Generate your own secret: openssl rand -base64 32
BETTER_AUTH_SECRET=local-dev-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3300
# Expo dev client/Go origins for native sign-in.
AUTH_TRUSTED_ORIGINS=robes://,robes-dev://,robes-staging://,exp://
# Optional: enable social sign-in (see docs/runbooks/environments.md).
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_APP_BUNDLE_ID=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional observability (off when unset; see docs/DEVELOPING.md "Observability and consent").
# NEXT_PUBLIC_POSTHOG_KEY=
# Build only: uploads source maps to PostHog error tracking.
# POSTHOG_PERSONAL_API_KEY=
# POSTHOG_PROJECT_ID=
# Waitlist bot check (SEC-60). Unset in dev skips it; Cloudflare's test keys also work:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
