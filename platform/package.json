{
  "name": "robes-platform",
  "private": true,
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "bootstrap": "pnpm install && pnpm services:up && pnpm db:reset && pnpm media:setup && pnpm --filter @robes/tokens build && node scripts/init-env.mjs",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@robes/app",
    "dev:mobile": "pnpm --filter @robes/mobile start",
    "dev:ios": "pnpm --filter @robes/mobile ios",
    "dev:android": "pnpm --filter @robes/mobile android",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm db:test",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "media:setup": "pnpm --filter @robes/media setup:local",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:new": "dbmate --migrations-dir db/migrations new",
    "db:reset": "node scripts/db-reset.mjs",
    "db:types": "pnpm --filter @robes/db gen:types",
    "db:test": "turbo run test:db --concurrency=1",
    "maintenance": "pnpm --filter @robes/workers maintenance"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.13.6",
    "dbmate": "2.36.0",
    "turbo": "2.11.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
